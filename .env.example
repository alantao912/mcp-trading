# Rename this file to .env and add your API keys.

# Get your OpenRouter API Key for accessing various LLMs
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Your Google Cloud Project ID
# Ensure you have authenticated via gcloud CLI: `gcloud auth application-default login`
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# Your Google Cloud Location (e.g., us-central1)
GOOGLE_CLOUD_LOCATION="us-central1"

